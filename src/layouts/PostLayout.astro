---
import Layout from './Layout.astro';
import TagList from '@/components/TagList.astro';

interface Props {
  title: string;
  date: Date;
  description: string;
  tags: string[];
}

const { title, date, description, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<Layout title={title} description={description} breadcrumbs={[{ label: 'Posts', href: '/posts' }, { label: title }]}>
  <article class="article-page">
    <header class="article-header anim-header">
      <div class="article-meta">
        <time datetime={date.toISOString()}>{formattedDate}</time>
        <TagList tags={tags} />
      </div>
      <h1>{title}</h1>
      <div class="accent-bar"></div>
    </header>

    <hr class="article-divider" />

    <div class="article-body anim-body">
      <slot />
    </div>

    <footer class="article-post-footer">
      <span class="filed-under">Filed under</span>
      <TagList tags={tags} />
    </footer>
  </article>
</Layout>

<style>
  .article-header {
    padding: 2rem 0 3rem;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }

  .article-meta time {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-accent);
  }

  .article-header h1 {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 72px;
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0;
    color: var(--color-text);
  }

  .accent-bar {
    width: 52px;
    height: 5px;
    background: var(--color-accent);
    margin-top: 28px;
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  .article-body {
    max-width: 640px;
    padding-top: 40px;
  }

  .article-post-footer {
    border-top: 1px solid var(--color-border);
    padding-top: 28px;
    margin-top: 48px;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .filed-under {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
  }

  @media (max-width: 900px) {
    .article-header h1 {
      font-size: clamp(2rem, 10vw, 72px);
    }
  }
</style>
