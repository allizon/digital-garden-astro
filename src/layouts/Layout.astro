---
import Nav from '@/components/Nav.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  breadcrumbs?: { label: string; href?: string }[];
}

const { title, description = 'Writing by Allison', breadcrumbs } = Astro.props;
const pageTitle = title ? `${title} — allizon.io` : 'allizon.io';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="allizon.io" href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet" />
    <script is:inline>
      // Apply saved theme before paint to prevent flash
      (function () {
        try {
          const saved = localStorage.getItem('theme');
          if (saved) document.documentElement.setAttribute('data-theme', saved);
        } catch (_) {}
      })();
    </script>
  </head>
  <body>
    <Nav />
    <slot name="overlay" />
    <main class="page-container" style={{ flex: 1, paddingTop: breadcrumbs ? '0.7rem' : '2rem', paddingBottom: '4rem' }}>
      {breadcrumbs && <Breadcrumbs segments={breadcrumbs} />}
      <slot />
    </main>
    <footer class="site-footer">
      <div class="page-container footer-inner">
        <span class="footer-copy">&copy; allizon.io</span>
        <span class="footer-italic">allizon.io</span>
      </div>
    </footer>
  </body>
</html>
