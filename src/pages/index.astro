---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '@/components/PostCard.astro';
import TagList from '@/components/TagList.astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
allPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const pixarEntries = await getCollection('pixar', ({ data }) => !data.draft);
pixarEntries.sort((a, b) => b.data.release_date.valueOf() - a.data.release_date.valueOf());

const posts = allPosts.slice(0, 10);
const hasMore = allPosts.length > 10;

const PIXAR_TOTAL = 27;
const pixarCount = pixarEntries.length;
const pixarProgress = Math.round((pixarCount / PIXAR_TOTAL) * 100);
const latestPixar = pixarEntries[0]?.data.title;

const allTags = [...new Set(allPosts.flatMap(p => p.data.tags))].sort();
const today = new Date();
const dateStr = today.toLocaleDateString('en-US', {
  weekday: 'long',
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
const dateISO = today.toISOString().split('T')[0];
---

<Layout>
  <div class="home-layout">
    <div class="home-main">

      <section class="hero anim-hero">
        <time class="hero-date" datetime={dateISO}>{dateStr}</time>
        <h1 class="hero-display">I'm Alix.</h1>
        <div class="hero-bar"></div>
        <p class="hero-bio">
          I write about pop culture, tech (including yes, <i>groan</i> AI), and the strange business
          of being alive in the 2020s.
        </p>
        <p class="hero-reading anim-reading">
          <span class="reading-dot"></span>
          Currently reading: <a href="#">Dungeon Crawler Carl</a> by Matt Dinniman
        </p>
      </section>

      <hr class="section-divider" />

      <div class="post-list">
        {posts.map((post, i) => (
          <div class:list={[i === 0 && 'anim-post-1', i === 1 && 'anim-post-2', i === 2 && 'anim-post-3']}>
            <PostCard
              id={post.id}
              title={post.data.title}
              date={post.data.date}
              description={post.data.description}
              tags={post.data.tags}
            />
          </div>
        ))}
      </div>
      {hasMore && (
        <p style="margin-top: 30px;">
          <a href="/posts" class="view-all">View all posts →</a>
        </p>
      )}
    </div>

    <aside class="home-sidebar">
      {pixarEntries.length > 0 && (
        <div class="sidebar-card sidebar-card-pixar anim-widget-1">
          <h3>Pixar Project</h3>
          <p>Watching every Pixar movie in release order.</p>
          <div class="progress-track" role="progressbar" aria-valuenow={pixarCount} aria-valuemin={0} aria-valuemax={PIXAR_TOTAL} aria-label={`${pixarCount} of ${PIXAR_TOTAL} movies`}>
            <div class="progress-fill anim-bar" style={`--progress-width: ${pixarProgress}%`}></div>
          </div>
          <p class="progress-label">{pixarCount} / {PIXAR_TOTAL} movies</p>
          {latestPixar && <p class="progress-label">Latest: {latestPixar}</p>}
          <a href="/pixar" class="sidebar-link">View project →</a>
        </div>
      )}

      {allTags.length > 0 && (
        <div class="sidebar-card sidebar-card-tags anim-widget-2">
          <h3>Tags</h3>
          <TagList tags={allTags} inline={true} />
        </div>
      )}
    </aside>
  </div>
</Layout>

<style>
  .home-layout {
    display: flex;
    gap: var(--width-gap);
    align-items: flex-start;
  }

  .home-main {
    flex: 1;
    min-width: 0;
  }

  /* ── Hero ────────────────────────────────────────────── */
  .hero {
    padding: 60px 0 52px;
  }

  .hero-date {
    display: block;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-accent);
    margin-bottom: 20px;
  }

  .hero-display {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 112px;
    line-height: 0.9;
    letter-spacing: -0.025em;
    color: var(--color-text);
    margin: 0;
  }

  .hero-bar {
    width: 76px;
    height: 5px;
    background: var(--color-accent);
    margin: 26px 0 34px;
  }

  .hero-bio {
    font-family: var(--font-body);
    font-weight: 400;
    font-size: 21px;
    line-height: 1.57;
    color: var(--color-text-body);
    max-width: 1100px;
    width: 100%;
    margin: 0 0 20px;
    text-wrap: pretty;
  }

  .hero-reading {
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--color-text-muted);
    margin: 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .reading-dot {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-accent);
    flex-shrink: 0;
  }

  .hero-reading a {
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid oklch(0.72 0.16 30);
  }

  .hero-reading a:hover {
    border-bottom-color: var(--color-accent);
  }

  .section-divider {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 0;
  }

  /* ── Post list ───────────────────────────────────────── */
  .post-list {
    padding-top: 0;
  }

  .view-all {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 12px;
    color: var(--color-accent);
    text-decoration: none;
  }

  .view-all:hover {
    text-decoration: underline;
  }

  /* ── Sidebar ───────────────────────────────────────── */
  .home-sidebar {
    width: var(--width-sidebar);
    flex-shrink: 0;
    position: sticky;
    top: 5rem;
  }

  @media (max-width: 900px) {
    .home-layout {
      flex-direction: column;
    }

    .home-sidebar {
      width: 100%;
      position: static;
    }

    .hero-display {
      font-size: clamp(3rem, 15vw, 112px);
    }

    .hero-bio {
      font-size: clamp(1rem, 3vw, 21px);
    }
  }
</style>
