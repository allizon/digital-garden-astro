---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";

const allEntries = await getCollection('pixar', ({ data }) => !data.draft);
allEntries.sort((a, b) => a.data.release_date.valueOf() - b.data.release_date.valueOf());
---

<Layout title="The Pixar Project">
  <main>
    <h1 class="mb-0 mt-2 pb-0">The Pixar Project</h1>

    <p style="margin-top: 1.5rem;">
      Watching and reviewing every Pixar movie in release order. Each entry
      includes thoughts, ratings, and miscellaneous contemporaneous notes.
    </p>

    <h2 class="mb-4 mt-8">Schedule &amp; Entries</h2>

    <div class="schedule">
      <div class="row header">
        <span class="date">Movie</span>
        <span class="flick">Released</span>
        <span class="rating">Rating</span>
      </div>

      {allEntries.map(entry => (
        <div class="row">
          <span class="date">
            <a href={`/pixar/${entry.id}`}>{entry.data.title}</a>
          </span>
          <span class="flick">{entry.data.release_date.getFullYear()}</span>
          <span class="rating text-muted">{'★'.repeat(entry.data.actual_rating)}{'☆'.repeat(5 - entry.data.actual_rating)}</span>
        </div>
      ))}
    </div>

    <h2 class="mb-4 mt-8">The Agenda</h2>

    <ul class="ml-16 list-disc">
      {allEntries.map(entry => (
        <li><a href={`/pixar/${entry.id}`}>{entry.data.title} ({entry.data.release_date.getFullYear()})</a></li>
      ))}
    </ul>
  </main>
</Layout>

<style>
  .schedule {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .row {
    display: flex;
    flex-direction: row;
    flex: 1;
    padding: 0.5rem 0.5rem;
    align-items: center;
  }

  .row .date { width: 45%; }
  .row .flick { width: 30%; }
  .row .rating { width: 25%; }

  .row:nth-child(even) {
    background-color: var(--color-surface);
  }

  .header {
    font-weight: 700;
    border-bottom: 2px solid var(--color-border);
  }

  .row span {
    padding-block: 0.25rem;
  }
</style>
