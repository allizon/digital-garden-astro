---
import { getCollection } from 'astro:content';
import Layout from "../layouts/Layout.astro";

const allEntries = await getCollection('pixar', ({ data }) => !data.draft);
allEntries.sort((a, b) => a.data.release_date.valueOf() - b.data.release_date.valueOf());

const entryIds = new Set(allEntries.map(e => e.id));

const agenda = [
  { title: 'Toy Story', slug: 'toy-story', date: 'Nov 22, 1995' },
  { title: "A Bug's Life", slug: 'a-bugs-life', date: 'Nov 25, 1998' },
  { title: 'Toy Story 2', slug: 'toy-story-2', date: 'Nov 24, 1999' },
  { title: 'Monsters, Inc.', slug: 'monsters-inc', date: 'Nov 2, 2001' },
  { title: 'Finding Nemo', slug: 'finding-nemo', date: 'May 30, 2003' },
  { title: 'The Incredibles', slug: 'the-incredibles', date: 'Nov 5, 2004' },
  { title: 'Cars', slug: 'cars', date: 'Jun 9, 2006' },
  { title: 'Ratatouille', slug: 'ratatouille', date: 'Jun 29, 2007' },
  { title: 'WALL-E', slug: 'wall-e', date: 'Jun 27, 2008' },
  { title: 'Up', slug: 'up', date: 'May 29, 2009' },
  { title: 'Toy Story 3', slug: 'toy-story-3', date: 'Jun 18, 2010' },
  { title: 'Cars 2', slug: 'cars-2', date: 'Jun 24, 2011' },
  { title: 'Brave', slug: 'brave', date: 'Jun 22, 2012' },
  { title: 'Monsters University', slug: 'monsters-university', date: 'Jun 21, 2013' },
  { title: 'Inside Out', slug: 'inside-out', date: 'Jun 19, 2015' },
  { title: 'The Good Dinosaur', slug: 'the-good-dinosaur', date: 'Nov 25, 2015' },
  { title: 'Finding Dory', slug: 'finding-dory', date: 'Jun 17, 2016' },
  { title: 'Cars 3', slug: 'cars-3', date: 'Jun 16, 2017' },
  { title: 'Coco', slug: 'coco', date: 'Nov 22, 2017' },
  { title: 'Incredibles 2', slug: 'incredibles-2', date: 'Jun 15, 2018' },
  { title: 'Toy Story 4', slug: 'toy-story-4', date: 'Jun 21, 2019' },
  { title: 'Onward', slug: 'onward', date: 'Mar 6, 2020' },
  { title: 'Soul', slug: 'soul', date: 'Dec 25, 2020' },
  { title: 'Luca', slug: 'luca', date: 'Jun 18, 2021' },
  { title: 'Turning Red', slug: 'turning-red', date: 'Mar 11, 2022' },
  { title: 'Lightyear', slug: 'lightyear', date: 'Jun 17, 2022' },
  { title: 'Elemental', slug: 'elemental', date: 'Jun 16, 2023' },
  { title: 'Inside Out 2', slug: 'inside-out-2', date: 'Jun 14, 2024' },
  { title: 'Win or Lose', slug: 'win-or-lose', date: 'Series, 2024' },
  { title: 'Elio', slug: 'elio', date: 'Jun 20, 2025' },
  { title: 'Hoppers', slug: 'hoppers', date: 'Mar 6, 2026' },
  { title: 'Toy Story 5', slug: 'toy-story-5', date: 'Jun 19, 2026' },
];
---

<Layout title="The Pixar Project">
  <main>
    <h1 class="mb-0 mt-2 pb-0">The Pixar Project</h1>

    <p style="margin-top: 1.5rem;">
      Revisiting every Pixar movie in release order, starting with the original <i>Toy Story</i> in 1995.
    </p>

    <h2 class="mb-4 mt-8">The Agenda</h2>

    <div class="schedule">
      <div class="row header">
        <span class="date">Movie</span>
        <span class="flick">Released</span>
        <span class="rating">Rating</span>
      </div>

      {agenda.map(item => {
        const entry = allEntries.find(e => e.id === item.slug);
        return (
          <div class={`row${entry ? '' : ' pending'}`}>
            <span class="date">
              {entry
                ? <a href={`/pixar/${item.slug}`}>{item.title}</a>
                : item.title
              }
            </span>
            <span class="flick text-small">{item.date}</span>
            <span class:list={['rating', 'text-small', ...(!entry ? ['text-muted'] : [])]}>
              {entry ? '★'.repeat(entry.data.actual_rating) + '☆'.repeat(5 - entry.data.actual_rating) : '—'}
            </span>
          </div>
        );
      })}
    </div>
  </main>
</Layout>

<style>
  .schedule {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .row {
    display: flex;
    flex-direction: row;
    flex: 1;
    padding: 0.5rem 0.5rem;
    align-items: center;
    border-bottom: 1px solid var(--color-border);
  }

  .row:last-child {
    border-bottom: none;
  }

  .row .date { width: 50%; }
  .row .flick { width: 25%; font-variant-numeric: tabular-nums; }
  .row .rating { width: 25%; }

  .row:nth-child(even):not(.header) {
    background-color: var(--color-surface);
  }

  .row.pending {
    color: var(--color-text-muted);
  }

  .row.pending .date a {
    color: var(--color-text-muted);
  }

  .row:not(.pending) .date {
    font-weight: 600;
  }

  .header {
    font-weight: 650;
    letter-spacing: 0.03em;
    text-transform: uppercase;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    border-bottom: 2px solid var(--color-border);
  }

  .row span {
    padding-block: 0.25rem;
  }
</style>
