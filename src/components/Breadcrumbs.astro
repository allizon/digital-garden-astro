---
interface Segment {
  label: string;
  href?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
const allSegments: Segment[] = [{ label: 'Home', href: '/' }, ...segments];
---

<nav class="breadcrumbs">
  {allSegments.map((seg, i) => (
    i < allSegments.length - 1
      ? <><a href={seg.href!}>{seg.label}</a> <span class="sep">/</span> </>
      : <span class="current">{seg.label}</span>
  ))}
</nav>

<style>
  .breadcrumbs {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .breadcrumbs a {
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .breadcrumbs a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .sep {
    margin: 0 0.35rem;
  }

  .current {
    color: var(--color-text);
  }
</style>
