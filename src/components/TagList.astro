---
interface Props {
  tags: string[];
  inline?: boolean;  // render as inline text (no list)
}

const { tags, inline = false } = Astro.props;
---

{
  inline ? (
    <span class="tag-list tag-list-inline">
      {tags.map((tag, i) => (
        <>{i > 0 && <span class="tag-sep">·</span>}<a href={`/tags/${tag}`} class="tag-inline">{tag}</a></>
      ))}
    </span>
  ) : (
    <ul class="tag-list">
      {tags.map(tag => (
        <li><a href={`/tags/${tag}`}>{tag}</a></li>
      ))}
    </ul>
  )
}

<style>
  .tag-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag-list a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-accent);
    text-decoration: none;
    transition: opacity 0.15s;
  }

  .tag-list a:hover {
    opacity: 0.75;
    text-decoration: none;
  }

  .tag-list-inline {
    display: inline;
  }

  .tag-inline {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.11em;
    color: var(--color-accent);
    text-decoration: none;
  }

  .tag-inline:hover {
    opacity: 0.75;
    text-decoration: none;
  }

  .tag-sep {
    margin: 0 0.15em;
    color: var(--color-text-muted);
  }
</style>
