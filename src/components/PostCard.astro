---
import TagList from './TagList.astro';

interface Props {
  id: string;
  title: string;
  date: Date;
  description: string;
  tags: string[];
}

const { id, title, date, description, tags } = Astro.props;

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="post-card">
  <div class="meta">
    <time datetime={date.toISOString()} class="text-muted text-small">{formattedDate}</time>
    <TagList tags={tags} />
  </div>
  <h2 class="title">
    <a href={`/posts/${id}`}>{title}</a>
  </h2>
  <p class="description text-muted">{description}</p>
</article>

<style>
  .post-card {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }

  .post-card:last-child { border-bottom: none; }

  .meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.4rem;
  }

  .title {
    font-size: 1.3rem;
    margin: 0 0 0.5rem;
    font-weight: 650;
    line-height: 1.25;
    letter-spacing: -0.01em;
  }

  .title a {
    color: var(--color-text);
    text-decoration: none;
  }

  .title a:hover {
    color: var(--color-accent);
    text-decoration: none;
  }

  .post-card time {
    color: var(--color-accent);
    font-weight: 500;
  }

  .description {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.6;
    max-width: 65ch;
  }
</style>
